{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sphere:biome-service:1:core",
  "title": "Proposed core record",
  "description": "Shared structural definitions. Finite values, vector orthonormality, canonical ownership and referenced identities require semantic validation.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "packId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "anyOf": [
        {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "capability": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "cell": {
      "type": "object",
      "properties": {
        "face": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741823
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741823
        }
      },
      "required": [
        "face",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "grid": {
      "type": "object",
      "properties": {
        "face": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741823
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741823
        },
        "local": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "face",
        "level",
        "x",
        "y",
        "local"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/id"
        },
        "abi": {
          "const": "sphere-biome-provider/1"
        },
        "digest": {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/digest"
        },
        "backendProfile": {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/id"
        }
      },
      "required": [
        "id",
        "abi",
        "digest",
        "backendProfile"
      ],
      "additionalProperties": false
    },
    "head": {
      "type": "object",
      "properties": {
        "bindingDigest": {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/digest"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "registryDigest": {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/digest"
        }
      },
      "required": [
        "bindingDigest",
        "revision",
        "registryDigest"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxCpuBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "maxGpuBufferBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "maxGpuTextureBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "maxTransientCpuBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "maxTransientGpuBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "maxJobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxStageRadiusM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000
        },
        "maxUploadBytesPerFrame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maxPrepareOpsPerSlice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "maxCpuBytes",
        "maxGpuBufferBytes",
        "maxGpuTextureBytes",
        "maxTransientCpuBytes",
        "maxTransientGpuBytes",
        "maxJobs",
        "maxStageRadiusM",
        "maxUploadBytesPerFrame",
        "maxPrepareOpsPerSlice"
      ],
      "additionalProperties": false
    },
    "address": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 2
        },
        "worldSeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "geographyRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "terrainRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "artRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "assetRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "heroRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "space": {
          "const": "shell"
        },
        "face": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741823
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741823
        },
        "local": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "schema",
        "worldSeed",
        "geographyRevision",
        "terrainRevision",
        "artRevision",
        "assetRevision",
        "heroRevision",
        "space",
        "face",
        "level",
        "x",
        "y",
        "local"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/id"
        },
        "profile": {
          "const": "region-gnomonic-metres-v1"
        },
        "origin": {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/address"
        },
        "east": {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/vec3"
        },
        "inward": {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/vec3"
        },
        "north": {
          "$ref": "urn:sphere:biome-service:1:core#/$defs/vec3"
        },
        "maximumAngularRadiusRad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.7853981633974483
        },
        "maximumLocalRadiusM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000
        }
      },
      "required": [
        "id",
        "profile",
        "origin",
        "east",
        "inward",
        "north",
        "maximumAngularRadiusRad",
        "maximumLocalRadiusM"
      ],
      "additionalProperties": false
    }
  }
}
